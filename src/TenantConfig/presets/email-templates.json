    "htmlBody": "<div style=\"background-color:#edf3f0;padding:32px 12px;font-family:Arial, Helvetica, sans-serif;color:#172f29\">\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"width:100%;max-width:600px;border-collapse:separate;border-spacing:0;background-color:#ffffff;border-radius:16px\">\n<tr><td style=\"background-color:#123b33;padding:24px;border-radius:16px;border-top:4px solid #00d7b5\">\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse\"><tr><td style=\"width:48px;vertical-align:middle\"><img src=\"{{logoUrl}}\" alt=\"Brand logo\" width=\"36\" height=\"36\" style=\"display:block;border:0px solid #123b33\"></td><td style=\"vertical-align:middle;color:#ffffff;font-size:24px;line-height:32px;font-weight:700\">{{siteName}}</td><td style=\"text-align:right;vertical-align:middle;color:#a9d2c6;font-size:10px;line-height:16px;letter-spacing:1px\">ACCOUNT<br>SECURITY</td></tr></table>\n</td></tr>\n<tr><td style=\"padding:32px 24px 24px\">\n<p style=\"margin:0 0 12px;color:#00846f;font-size:11px;line-height:18px;letter-spacing:2px;font-weight:700\">EMAIL VERIFICATION</p>\n<p style=\"margin:0 0 16px;color:#172f29;font-size:28px;line-height:36px;font-weight:700\">Verify your email</p>\n<p style=\"margin:0 0 24px;color:#52685f;font-size:15px;line-height:26px\">Welcome to {{siteName}}. Enter the code below on the registration page to verify your email address.</p>\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:separate;border-spacing:0;background-color:#eff8f3;border:1px solid #d7e9df;border-radius:12px\"><tr><td style=\"padding:24px 12px;text-align:center\">\n<p style=\"margin:0 0 12px;color:#58776a;font-size:11px;line-height:18px;letter-spacing:1px\">YOUR VERIFICATION CODE</p>\n<p style=\"margin:0;color:#123b33;font-family:Courier New, monospace;font-size:40px;line-height:52px;font-weight:700;letter-spacing:6px\">{{code}}</p>\n</td></tr></table>\n<p style=\"margin:16px 0 28px;color:#657a71;font-size:13px;line-height:22px\">This code is valid for {{validMinutes}} minutes from your request. Please complete the process promptly.</p>\n<div style=\"border-left:3px solid #c3dfd0;padding:0 0 0 16px\">\n<p style=\"margin:0 0 6px;color:#304f41;font-size:13px;line-height:20px;font-weight:700\">Keep your account secure</p>\n<p style=\"margin:0;color:#657a71;font-size:13px;line-height:22px\">Never share this code. Our team will never ask you for a verification code.</p>\n</div>\n</td></tr>\n<tr><td style=\"padding:20px 24px 24px;border-top:1px solid #edf2ee\"><p style=\"margin:0 0 6px;color:#72867c;font-size:12px;line-height:20px\">If you did not request this, you can ignore this email.</p><p style=\"margin:0;color:#72867c;font-size:12px;line-height:20px\">This is an automated message. Please do not reply.</p></td></tr>\n</table>\n<p style=\"margin:20px 0 0;text-align:center;color:#71857a;font-size:11px;line-height:18px\">{{siteName}} · ACCOUNT SECURITY</p>\n</div>"
  },
