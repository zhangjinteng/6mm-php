{
  "register": {
    "zh-CN": "<div style=\"background-color:#fafafa;padding:32px 12px;font-family:Arial, Helvetica, sans-serif;color:#222222\">\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"width:100%;max-width:640px;border-collapse:separate;border-spacing:0;background-color:#ffffff;border:1px solid #dedede;border-radius:12px\">\n<tr><td style=\"padding:32px 24px\">\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse\"><tr><td style=\"padding:0 0 24px;vertical-align:top\"><img src=\"{{logoUrl}}\" alt=\"Brand logo\" height=\"48\" style=\"display:block;height:48px;max-width:100%;border:0px solid #222222\"></td></tr></table><p style=\"margin:0 0 16px;color:#222222;font-size:22px;line-height:30px;font-weight:700\">验证您的邮箱</p>\n<p style=\"margin:0 0 20px;color:#333333;font-size:15px;line-height:26px\">欢迎加入 {{siteName}}。请在注册页面输入以下验证码，完成邮箱验证。</p>\n<p style=\"margin:0 0 28px;color:#222222;font-size:32px;line-height:44px;font-weight:500;letter-spacing:2px\">{{code}}</p>\n<div style=\"border-top:1px solid #dedede;padding:24px 0 0\">\n<p style=\"margin:0 0 12px;color:#666666;font-size:12px;line-height:20px\">此验证码自申请起 {{validMinutes}} 分钟内有效。</p>\n<p style=\"margin:0 0 8px;color:#666666;font-size:12px;line-height:20px\">请勿将验证码透露给他人。我们的工作人员不会向您索取验证码。</p>\n<p style=\"margin:0 0 8px;color:#666666;font-size:12px;line-height:20px\">如果这不是您发起的操作，请忽略此邮件。</p>\n<p style=\"margin:0;color:#777777;font-size:12px;line-height:20px\">此邮件由系统自动发送，请勿直接回复。</p>\n</div>\n</td></tr>\n</table>\n</div>",
    "en": "<div style=\"background-color:#fafafa;padding:32px 12px;font-family:Arial, Helvetica, sans-serif;color:#222222\">\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"width:100%;max-width:640px;border-collapse:separate;border-spacing:0;background-color:#ffffff;border:1px solid #dedede;border-radius:12px\">\n<tr><td style=\"padding:32px 24px\">\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse\"><tr><td style=\"padding:0 0 24px;vertical-align:top\"><img src=\"{{logoUrl}}\" alt=\"Brand logo\" height=\"48\" style=\"display:block;height:48px;max-width:100%;border:0px solid #222222\"></td></tr></table><p style=\"margin:0 0 16px;color:#222222;font-size:22px;line-height:30px;font-weight:700\">Verify your email</p>\n<p style=\"margin:0 0 20px;color:#333333;font-size:15px;line-height:26px\">Welcome to {{siteName}}. Enter the code below on the registration page to verify your email address.</p>\n<p style=\"margin:0 0 28px;color:#222222;font-size:32px;line-height:44px;font-weight:500;letter-spacing:2px\">{{code}}</p>\n<div style=\"border-top:1px solid #dedede;padding:24px 0 0\">\n<p style=\"margin:0 0 12px;color:#666666;font-size:12px;line-height:20px\">This code expires {{validMinutes}} minutes after your request.</p>\n<p style=\"margin:0 0 8px;color:#666666;font-size:12px;line-height:20px\">Never share this code. Our team will never ask you for a verification code.</p>\n<p style=\"margin:0 0 8px;color:#666666;font-size:12px;line-height:20px\">If you did not request this, you can ignore this email.</p>\n<p style=\"margin:0;color:#777777;font-size:12px;line-height:20px\">This is an automated message. Please do not reply.</p>\n</div>\n</td></tr>\n</table>\n</div>"
  },
  "login": {
    "zh-CN": "<div style=\"background-color:#fafafa;padding:32px 12px;font-family:Arial, Helvetica, sans-serif;color:#222222\">\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"width:100%;max-width:640px;border-collapse:separate;border-spacing:0;background-color:#ffffff;border:1px solid #dedede;border-radius:12px\">\n<tr><td style=\"padding:32px 24px\">\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse\"><tr><td style=\"padding:0 0 24px;vertical-align:top\"><img src=\"{{logoUrl}}\" alt=\"Brand logo\" height=\"48\" style=\"display:block;height:48px;max-width:100%;border:0px solid #222222\"></td></tr></table><p style=\"margin:0 0 16px;color:#222222;font-size:22px;line-height:30px;font-weight:700\">确认是您本人登录</p>\n<p style=\"margin:0 0 20px;color:#333333;font-size:15px;line-height:26px\">我们收到了您登录 {{siteName}} 的请求。请在登录页面输入以下验证码。</p>\n<p style=\"margin:0 0 28px;color:#222222;font-size:32px;line-height:44px;font-weight:500;letter-spacing:2px\">{{code}}</p>\n<div style=\"border-top:1px solid #dedede;padding:24px 0 0\">\n<p style=\"margin:0 0 12px;color:#666666;font-size:12px;line-height:20px\">此验证码自申请起 {{validMinutes}} 分钟内有效。</p>\n<p style=\"margin:0 0 8px;color:#666666;font-size:12px;line-height:20px\">请勿将验证码透露给他人。我们的工作人员不会向您索取验证码。</p>\n<p style=\"margin:0 0 8px;color:#666666;font-size:12px;line-height:20px\">如果这不是您发起的操作，请忽略此邮件。</p>\n<p style=\"margin:0;color:#777777;font-size:12px;line-height:20px\">此邮件由系统自动发送，请勿直接回复。</p>\n</div>\n</td></tr>\n</table>\n</div>",
    "en": "<div style=\"background-color:#fafafa;padding:32px 12px;font-family:Arial, Helvetica, sans-serif;color:#222222\">\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"width:100%;max-width:640px;border-collapse:separate;border-spacing:0;background-color:#ffffff;border:1px solid #dedede;border-radius:12px\">\n<tr><td style=\"padding:32px 24px\">\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse\"><tr><td style=\"padding:0 0 24px;vertical-align:top\"><img src=\"{{logoUrl}}\" alt=\"Brand logo\" height=\"48\" style=\"display:block;height:48px;max-width:100%;border:0px solid #222222\"></td></tr></table><p style=\"margin:0 0 16px;color:#222222;font-size:22px;line-height:30px;font-weight:700\">Confirm your sign-in</p>\n<p style=\"margin:0 0 20px;color:#333333;font-size:15px;line-height:26px\">We received a request to sign in to {{siteName}}. Enter the code below on the sign-in page.</p>\n<p style=\"margin:0 0 28px;color:#222222;font-size:32px;line-height:44px;font-weight:500;letter-spacing:2px\">{{code}}</p>\n<div style=\"border-top:1px solid #dedede;padding:24px 0 0\">\n<p style=\"margin:0 0 12px;color:#666666;font-size:12px;line-height:20px\">This code expires {{validMinutes}} minutes after your request.</p>\n<p style=\"margin:0 0 8px;color:#666666;font-size:12px;line-height:20px\">Never share this code. Our team will never ask you for a verification code.</p>\n<p style=\"margin:0 0 8px;color:#666666;font-size:12px;line-height:20px\">If you did not request this, you can ignore this email.</p>\n<p style=\"margin:0;color:#777777;font-size:12px;line-height:20px\">This is an automated message. Please do not reply.</p>\n</div>\n</td></tr>\n</table>\n</div>"
  },
  "password_set": {
    "zh-CN": "<div style=\"background-color:#fafafa;padding:32px 12px;font-family:Arial, Helvetica, sans-serif;color:#222222\">\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"width:100%;max-width:640px;border-collapse:separate;border-spacing:0;background-color:#ffffff;border:1px solid #dedede;border-radius:12px\">\n<tr><td style=\"padding:32px 24px\">\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse\"><tr><td style=\"padding:0 0 24px;vertical-align:top\"><img src=\"{{logoUrl}}\" alt=\"Brand logo\" height=\"48\" style=\"display:block;height:48px;max-width:100%;border:0px solid #222222\"></td></tr></table><p style=\"margin:0 0 16px;color:#222222;font-size:22px;line-height:30px;font-weight:700\">设置您的登录密码</p>\n<p style=\"margin:0 0 20px;color:#333333;font-size:15px;line-height:26px\">请使用以下验证码，完成 {{siteName}} 账户的首次密码设置。</p>\n<p style=\"margin:0 0 28px;color:#222222;font-size:32px;line-height:44px;font-weight:500;letter-spacing:2px\">{{code}}</p>\n<div style=\"border-top:1px solid #dedede;padding:24px 0 0\">\n<p style=\"margin:0 0 12px;color:#666666;font-size:12px;line-height:20px\">此验证码自申请起 {{validMinutes}} 分钟内有效。</p>\n<p style=\"margin:0 0 8px;color:#666666;font-size:12px;line-height:20px\">请勿将验证码透露给他人。我们的工作人员不会向您索取验证码。</p>\n<p style=\"margin:0 0 8px;color:#666666;font-size:12px;line-height:20px\">如果这不是您发起的操作，请忽略此邮件。</p>\n<p style=\"margin:0;color:#777777;font-size:12px;line-height:20px\">此邮件由系统自动发送，请勿直接回复。</p>\n</div>\n</td></tr>\n</table>\n</div>",
    "en": "<div style=\"background-color:#fafafa;padding:32px 12px;font-family:Arial, Helvetica, sans-serif;color:#222222\">\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"width:100%;max-width:640px;border-collapse:separate;border-spacing:0;background-color:#ffffff;border:1px solid #dedede;border-radius:12px\">\n<tr><td style=\"padding:32px 24px\">\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;border-collapse:collapse\"><tr><td style=\"padding:0 0 24px;vertical-align:top\"><img src=\"{{logoUrl}}\" alt=\"Brand logo\" height=\"48\" style=\"display:block;height:48px;max-width:100%;border:0px solid #222222\"></td></tr></table><p style=\"margin:0 0 16px;color:#222222;font-size:22px;line-height:30px;font-weight:700\">Set your password</p>\n<p style=\"margin:0 0 20px;color:#333333;font-size:15px;line-height:26px\">Use the code below to set the first password for your {{siteName}} account.</p>\n<p style=\"margin:0 0 28px;color:#222222;font-size:32px;line-height:44px;font-weight:500;letter-spacing:2px\">{{code}}</p>\n<div style=\"border-top:1px solid #dedede;padding:24px 0 0\">\n<p style=\"margin:0 0 12px;color:#666666;font-size:12px;line-height:20px\">This code expires {{validMinutes}} minutes after your request.</p>\n<p style=\"margin:0 0 8px;color:#666666;font-size:12px;line-height:20px\">Never share this code. Our team will never ask you for a verification code.</p>\n<p style=\"margin:0 0 8px;color:#666666;font-size:12px;line-height:20px\">If you did not request this, you can ignore this email.</p>\n<p style=\"margin:0;color:#777777;font-size:12px;line-height:20px\">This is an automated message. Please do not reply.</p>\n</div>\n</td></tr>\n</table>\n</div>"
