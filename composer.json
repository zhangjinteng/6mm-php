{
    "name": "zhangjinteng/6mm-php",
    "description": "Shared PHP domain and query services for 6MM administration applications.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-bcmath": "*",
        "ext-curl": "*",
        "ext-intl": "*",
        "illuminate/database": "^8.75",
        "zhangjinteng/6mm-addr": "^1.0.1",
        "zhangjinteng/6mm-prediction": "^1.0.7"
    },
    "suggest": {
        "zhangjinteng/6mm-addr": "Adds versioned English and Chinese country, region, and city names to IP locations."
    },
    "autoload": {
        "psr-4": {
            "SixMm\\Shared\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SixMm\\Shared\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "scripts": {
        "test": [
            "@php tests/run.php",
            "@php tests/ip_locations.php",
            "@php tests/prediction.php",
            "@php tests/prediction_rules.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "repositories": [{
        "name": "6mm-prediction",
        "type": "vcs",
        "url": "https://github.com/zhangjinteng/6mm-prediction.git",
        "no-api": true
    },{
        "name": "6mm-addr",
        "type": "vcs",
        "url": "https://github.com/zhangjinteng/6mm-addr.git",
        "no-api": true
    }, {
        "name": "packagist.org",
        "type": "composer",
        "url": "https://repo.packagist.org"
    }]
}
