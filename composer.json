{
    "name": "zhangjinteng/6mm-php",
    "description": "Shared PHP domain and query services for 6MM administration applications.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "brick/math": "^0.9.3 || ^0.10 || ^0.11 || ^0.12 || ^0.13 || ^0.14",
        "illuminate/validation": "^8.75",
        "php": "^8.2",
        "ext-bcmath": "*",
        "ext-curl": "*",
        "ext-intl": "*",
        "illuminate/database": "^8.75",
        "zhangjinteng/6mm-addr": "^1.0.1",
        "illuminate/http": "^8.75",
        "ext-mbstring": "*",
        "ramsey/uuid": "^4.7"
    },
    "suggest": {
        "zhangjinteng/6mm-addr": "Adds versioned English and Chinese country, region, and city names to IP locations."
    },
    "autoload": {
        "psr-4": {
            "SixMm\\Shared\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SixMm\\Shared\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "scripts": {
        "test": [
            "@php tests/liquidation_warnings.php",
            "@php tests/contract_sources.php",
            "@php tests/run.php",
            "@php tests/user_contract_metrics.php",
            "@php tests/funding_change_logs.php",
            "@php tests/ip_locations.php",
            "@php tests/symbol_tags.php",
            "@php tests/translation_config.php",
            "@php tests/user_mappings.php",
            "@php tests/funding_overview.php",
            "@php tests/futures_reports.php",
            "@php tests/platform_trade_summary.php",
            "@php tests/report_access_scope.php",
            "@php tests/risk_reports.php",
            "@php tests/fee_reports.php",
            "@php tests/user_net_pnl_reports.php",
            "@php tests/platform_pnl_reports.php",
            "@php tests/asset_balance_reports.php",
            "@php tests/prediction_user_pnl_reports.php",
            "@php tests/prediction_operations.php",
            "@php tests/prediction_configuration.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "repositories": [
        {
            "name": "6mm-addr",
            "type": "vcs",
            "url": "https://github.com/zhangjinteng/6mm-addr.git",
            "no-api": true
        },
        {
            "name": "packagist.org",
            "type": "composer",
            "url": "https://repo.packagist.org"
        }
    ],
    "archive": { "exclude": ["/vendor", "/agent_admin", "/composer.lock", "/.git*", "/.phpunit.result.cache"] }
}
